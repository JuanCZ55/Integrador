mixin navbarMedico()
  ul.nav.nav-underline.fs-4.ms-auto
    li.nav-item
      a.nav-link.text-primary-emphasis(href="/medico") Inicio
    li.nav-item
      a.nav-link.text-primary-emphasis(href="/medico/sinAsignar") Sin asignar
    li.nav-item
      a.nav-link.text-primary-emphasis(href="/medico/misPacientes") Mis pacientes
    +usuarioDropdown()

mixin usuarioDropdown()
  li.nav-item.dropdown
    a.nav-link.dropdown-toggle.d-flex.align-items-center(href="#", role="button", data-bs-toggle="dropdown")
      .bg-primary.text-white.rounded-circle.d-flex.align-items-center.justify-content-center(style="width: 40px; height: 40px; font-size: 18px; font-weight: bold;")
        = user.nombreCompleto.charAt(0).toUpperCase()
      span.ms-2= user.nombreCompleto
    ul.dropdown-menu.dropdown-menu-end
      li
        a.dropdown-item(href="/perfil") Perfil
      if user.id_rol === 1
        li
          hr.dropdown-divider
        li
          a.dropdown-item(href="/admin/inicio") Admin
        li
          a.dropdown-item(href="/medico") Médico
        li
          a.dropdown-item(href="/enfermeria") Enfermería
        li
          a.dropdown-item(href="/admision") Admisión
      li
        hr.dropdown-divider
      li
        a.dropdown-item(href="/logout") Cerrar Sesión