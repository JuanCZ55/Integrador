extends ../layout.pug
include ../mixins.pug
block navbar
  include ../mixinsNavbar.pug
  +navbarEnfermeria
block main 
  +alert(mensajeAlert, alertClass)
  table table.table.table-striped.mt-3
    thead
      tr
        th(scope="col") Cama
        th(scope="col") DNI
        th(scope="col") Nombre
        th(scope="col") Médico Responsable
        th(scope="col") Ultima Revision
        th(scope="col") Medicamento
        th(scope="col") Acciones
        th(scope="col") Ver 
    tbody
      each paciente in pacientes
        tr
          td #{paciente.cama}
          td #{paciente.dni}
          td #{paciente.nombre}
          td #{paciente.medicoResponsable}
          td #{paciente.ultimaRevision}
          td #{paciente.medicamento}//-muestra el tiempo del futuro medicamento
          td 
            a.btn.btn-primary(href=`/enfermeria/atencion/${paciente.id}`) Singos Vitales
            a.btn.btn-primary(href=`/enfermeria/evaluacion/${paciente.id}`) Evaluación
          td
            a.btn.btn-info(href=`/enfermeria/historial/${paciente.id}`) Historial
            a.btn.btn-info(href=`/enfermeria/preescripciones/${paciente.id}`) Preescripciones