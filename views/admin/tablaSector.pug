extends ../layout.pug
include ../mixins.pug

block scripts
	script.
		function confirmDelete(nombre) {
			if (confirm('¿Estás seguro de eliminar el sector "' + nombre + '"?')) {
				document.getElementById('deleteForm-' + nombre).submit();
			}
		}

block navbar
	include ../mixinsNavbar.pug
	+navbarAdmin()

block main
	.w-75.container
		if mensajeAlert
			+alert(mensajeAlert, alertClass)
		h2.text-center.mt-4 Lista de Sectores
		.form-group.text-end.mb-3
			form(action="/admin/sector" method="get" style="display:inline;")
				button.btn.btn-success(type="submit")
					i.fas.fa-plus.me-1
					| Agregar
		table.table.table-striped.table-bordered.mt-4
			thead
				tr
					th ID
					th Nombre
					th Acciones
			tbody
				if sectores.length === 0
					tr
						td(colspan="3") No hay sectores registrados
				else
					each sector in sectores
						tr
							td= sector.id_sector
							td= sector.nombre
							td
								a.btn.btn-primary.btn-sm(href=`/admin/sector?nombre=${sector.nombre}`) Editar
								a.btn.btn-success.btn-sm(href=`/admin/habitacion?id_sector=${sector.id_sector}`) Agregar Habitación
								form(id=`deleteForm-${sector.nombre}` action="/admin/sector/delete" method="post" style="display:inline;")
									input(type="hidden" name="nombre" value=sector.nombre)
								button.btn.btn-danger.btn-sm(type="button" onclick=`confirmDelete('${sector.nombre}')`) Eliminar