extends ../layout.pug
include ../mixins.pug

block scripts
	script.
		function confirmDelete(id) {
			if (confirm('¿Estás seguro de eliminar la cama con ID ' + id + '?')) {
				document.getElementById('deleteForm-' + id).submit();
			}
		}

block navbar
	include ../mixinsNavbar.pug
	+navbarAdmin()

block main
	.w-75.container
		if mensajeAlert
			+alert(mensajeAlert, alertClass)
		h2.text-center.mt-4 Lista de Camas
		.form-group.text-end.mb-3
			form(action="/admin/cama" method="get" style="display:inline;")
				button.btn.btn-success(type="submit")
					i.fas.fa-plus.me-1
					| Agregar
		table.table.table-striped.table-bordered.mt-4
			thead
				tr
					th ID
					th Habitación
					th Sector
					th N° Cama
					th Estado
					th Acciones
			tbody
				if camas.length === 0
					tr
						td(colspan="6") No hay camas registradas
				else
					each cama in camas
						tr
							td= cama.id_cama
							td= cama.habitacion
							td= cama.sector
							td= cama.n_cama
							td= cama.estado
							td
								a.btn.btn-primary.btn-sm(href=`/admin/cama?id_cama=${cama.id_cama}`) Editar
								form(id=`deleteForm-${cama.id_cama}` action="/admin/cama/delete" method="post" style="display:inline;")
									input(type="hidden" name="id_cama" value=cama.id_cama)
								button.btn.btn-danger.btn-sm(type="button" onclick=`confirmDelete(${cama.id_cama})`) Eliminar