extends ../layout
include ../mixins
block navbar
  include ../mixinsNavbar.pug
  +navbarAdmin()
block main
  .container-md.border.border-2.border-dark.rounded-3.d-flex.justify-content-center.align-items-center.form-box.mt-5
    form.p-4.w-100(method="GET", action="usuarios", novalidate)
      h2.text-center.mb-4 Iniciar Sesión
      small.text-white Primero busque por dni para verificar si se puede crear el usuario
      if mensajeAlert
        +alert(mensajeAlert, alertClass)
      .mb-3  
        label.form-label(for="dni") DNI
        .input-group
          input.form-control(type="number", id="dni", placeholder="48455713", value= dni || "", name="dni")
          button.btn.btn-outline-info.text-light(type="submit", id="btnBuscar") Buscar
      .mb-3
        label.form-label(for="username") Usuario 
          small.text-muted.mx-2 3–20 letras o números ( . _ - )
        input.form-control(type="text",id="username",name="username", placeholder="Ingrese su usuario",value=username || "")

      .mb-3
        label.form-label(for="password") Contraseña
          small.text-muted.mx-2 8+ caracteres, con letra, número y (- _ .)

        input.form-control(type="password", id="password",name="password", placeholder="Ingrese su contraseña",value=password || "")
        br
        button.btn.btn-primary(type="submit",name="accion",value="modificar",formmethod="POST") Guardar
            
  +debug(locals)
