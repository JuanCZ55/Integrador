extends ../layout.pug
include ../mixins.pug

block scripts

block navbar
	include ../mixinsNavbar.pug
	+navbarAdmin()

block main
	.container-md.border.border-2.border-dark.rounded-3.d-flex.justify-content-center.align-items-center.form-box.mt-5
		form.p-4.w-100(method="GET", action="/admin/cama", novalidate)
			h2.text-center.mb-4 Gestión de Cama
			if mensajeAlert
				+alert(mensajeAlert, alertClass)
			.mb-3
				label.form-label(for="id_cama") ID Cama*
				.input-group
					input.form-control(type="number", id="id_cama", placeholder="Ingrese ID de cama", value=id_cama || '', name="id_cama")
					button.btn.btn-outline-secondary.text-light(type="submit", id="btnBuscar") Buscar
			.mb-3
				label.form-label(for="id_habitacion") ID Habitación
				input.form-control(type="number", id="id_habitacion" name="id_habitacion" value=id_habitacion required)
			.mb-3
				label.form-label(for="n_cama") Número de Cama
				input.form-control(type="number", id="n_cama" name="n_cama" value=n_cama required)
			.mb-3
				label.form-label(for="estado") Estado
				select.form-control(id="estado" name="estado")
					option(value="1" selected= estado == 1) Disponible
					option(value="2" selected= estado == 2) Ocupada
					option(value="3" selected= estado == 3) Mantenimiento
			.mb-3
				button.btn.btn-primary(type="submit", name="accion", value="guardar", formmethod="POST") Guardar