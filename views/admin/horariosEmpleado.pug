extends ../layout.pug
include ../mixins.pug
block scripts 

block navbar
  include ../mixinsNavbar.pug
  +navbarAdmin()

block main
  .w-75.container
    +alert(mensajeAlert, alertClass)
    div.container-md.border.border-2.border-dark.rounded-3.d-flex.justify-content-center.align-items-center.form-box
      .p-4
        .mb-3.d-flex.align-items-center.gap-2
          h2.mx-auto.mb-0 Gestión de Horarios Medico 
        .row
          .col-12
            .mb-3
              form(action="horarios", method="get") 
                label.form-label(for="dni") DNI*
                .input-group
                  input.form-control(type="number", id="dni", placeholder="48455713", value=(persona && persona.dni) ||dni|| '', name="dni")
                  button.btn.btn-outline-secondary.text-light(type="submit", id="btnBuscar") Buscar
          .col-12 
            .mb-3
              label.form-label(for="nombreApellido") Nombre y Apellido
              input.form-control(type="text", id="nombreApellido", placeholder="Juan Carlos Perez", value=(persona && persona.nombre + ' ' + persona.apellido) || '', name="nombreApellido",readonly)
          form(novalidate, action="/admin/horarios", method="POST")
            .col-12
              .mb-3
                label.form-label(for="id_medico") ID
                input.form-control(type="number", id="id_medico", placeholder="ID", value=(persona && persona.empleado.medico.id_medico) || '', name="id_medico", readonly)
            .col-12
              .mb-3
                label.form-label Horarios Semanales
                table.table.table-bordered.table-striped.table-hover.text-center.align-middle.shadow-sm
                  thead.table-dark
                    tr
                      th Día
                      th Entrada
                      th Salida
                  - var horarioMap = {}
                  - if (persona && persona.empleado && persona.empleado.medico && persona.empleado.medico.horarios) {
                  -   persona.empleado.medico.horarios.forEach(h => {
                  -     horarioMap[h.dia] = { entrada: h.hora_inicio, salida: h.hora_fin }
                  -   })
                  - }
                  tbody
                    tr
                      td.fw-semibold Lunes
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eL", id="lunes_e", value=horarioMap['Lunes'] ? horarioMap['Lunes'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sL", id="lunes_s", value=horarioMap['Lunes'] ? horarioMap['Lunes'].salida : '', placeholder="16:00")
                    tr
                      td.fw-semibold Martes
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eM", id="martes_e", value=horarioMap['Martes'] ? horarioMap['Martes'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sM", id="martes_s", value=horarioMap['Martes'] ? horarioMap['Martes'].salida : '', placeholder="16:00")
                    tr
                      td.fw-semibold Miércoles
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eX", id="miercoles_e", value=horarioMap['Miercoles'] ? horarioMap['Miercoles'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sX", id="miercoles_s", value=horarioMap['Miercoles'] ? horarioMap['Miercoles'].salida : '', placeholder="16:00")
                    tr
                      td.fw-semibold Jueves
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eJ", id="jueves_e", value=horarioMap['Jueves'] ? horarioMap['Jueves'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sJ", id="jueves_s", value=horarioMap['Jueves'] ? horarioMap['Jueves'].salida : '', placeholder="16:00")
                    tr
                      td.fw-semibold Viernes
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eV", id="viernes_e", value=horarioMap['Viernes'] ? horarioMap['Viernes'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sV", id="viernes_s", value=horarioMap['Viernes'] ? horarioMap['Viernes'].salida : '', placeholder="16:00")
                    tr
                      td.fw-semibold Sábado
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eS", id="sabado_e", value=horarioMap['Sabado'] ? horarioMap['Sabado'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sS", id="sabado_s", value=horarioMap['Sabado'] ? horarioMap['Sabado'].salida : '', placeholder="12:00")
                    tr
                      td.fw-semibold Domingo
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_eD", id="domingo_e", value=horarioMap['Domingo'] ? horarioMap['Domingo'].entrada : '', placeholder="08:00")
                      td.p-2: input.form-control.form-control-sm(type="time", name="time_sD", id="domingo_s", value=horarioMap['Domingo'] ? horarioMap['Domingo'].salida : '', placeholder="12:00")
                .mb-3.text-center
                  button.btn.btn-primary(type="submit") Guardar Horarios
            small.text-white.text-center.mx-auto
              | Primero busque al empleado por su DNI, luego modifique/cree los horarios y finalmente haga click en "Guardar Horarios"
    +debug(locals)