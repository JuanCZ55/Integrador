extends ../layout.pug
include ../mixins.pug
block scripts 

block navbar
  include ../mixinsNavbar.pug
  +navbarAdmin()
block main
  .w-75.container
    +alert(mensajeAlert, alertClass)
    div.container-md.border.border-2.border-dark.rounded-3.d-flex.justify-content-center.align-items-center.form-box
      
      form.p-4(novalidate, action="/admin/profesional", method="GET")
        .mb-3.d-flex.align-items-center.gap-2
          h2.mx-auto.mb-0 Gestión de Médico-Enfermero
        .row
          small.text-white Los campos marcados con * son obligatorios. 
          small.text-white Primero busque por DNI, para poder crear o modificar.

          .col-6
            .mb-3
              label.form-label(for="id") ID*
              input.form-control(type="number", id="id", value=(datos && datos.id_persona) || '', name="id", readonly)
          .col-6
            .mb-3
              label.form-label(for="dni") DNI*
              .input-group
                input.form-control(type="number", id="dni", placeholder="48455713", value=(datos && datos.dni) || '', name="dni", required)
                button.btn.btn-outline-secondary.text-light(type="submit", id="btnBuscar") Buscar
          .col-6      
            .mb-3
              label.form-label(for="nombre") Nombre*
              input.form-control(type="text", id="nombre", placeholder="Juan Carlos", value=(datos && datos.nombre) || '', name="nombre", required)
          .col-6
            .mb-3
              label.form-label(for="apellido") Apellido*
              input.form-control(type="text", id="apellido", placeholder="Perez", value=(datos && datos.apellido) || '', name="apellido", required)
          .col-6
            .mb-3
              label.form-label(for="f_nacimiento") Fecha de Nacimiento*
              input.form-control(type="date", id="f_nacimiento", value=(datos && datos.f_nacimiento) || '', name="f_nacimiento", required)
          .col-6
            .mb-3
              label.form-label(for="genero") Género*
              select.form-select(id="genero", name="genero", required)
                option(value="") Seleccione
                option(value="Masculino" selected=(datos && datos.genero==="Masculino")?true:undefined) Masculino
                option(value="Femenino" selected=(datos && datos.genero==="Femenino")?true:undefined) Femenino
                option(value="Otro" selected=(datos && datos.genero==="Otro")?true:undefined) Otro
          .col-6
            .mb-3
              label.form-label(for="telefono") Teléfono*
              input.form-control(type="text", id="telefono", value=(datos && datos.telefono) || '', name="telefono")
          .col-6
            .mb-3
              label.form-label(for="mail") Email*
              input.form-control(type="email", id="mail", value=(datos && datos.mail) || '', name="mail")
          hr
          .col-6
            .mb-3
              label.form-label(for="fecha_ingreso") Fecha de Ingreso*
              input.form-control(type="date", id="fecha_ingreso", value=(datos && datos.fecha_ingreso) || '', name="fecha_ingreso", required)
          .col-6
          
            .mb-3
              label.form-label(for="id_rol") Rol*
              select.form-select(id="id_rol", name="id_rol", required)
                option(value="3" selected=(datos && datos.id_rol === 3) ? true : undefined) Médico
                option(value="4" selected=(datos && datos.id_rol === 4) ? true : undefined) Enfermero

          
          hr
          .col-12
            .mb-3
              label.form-label(for="especialidad") Especialidad*
              input(name="especialidad" class="form-control tagify--custom-dropdown" placeholder="Agregue una especialidad" value=(datos && datos.especialidad) || '')
          .col-6
            .mb-3
              label.form-label(for="nro_licencia") Numero de Licencia*
              input.form-control(type="text", id="nro_licencia", value=(datos && datos.nro_licencia) || '', name="nro_licencia", required)
          .col-6
            .mb-3
              label.form-label(for="estado") Estado*
              select.form-select(id="estado", name="estado", required)
                option(value="1" selected=(datos && datos.estado==1)?true:undefined) Activo
                option(value="2" selected=(datos && datos.estado==2)?true:undefined) Inactivo
                option(value="3" selected=(datos && datos.estado==3)?true:undefined) Suspendido

          .d-flex.justify-content-between
            button.btn.btn-primary(type="submit",name="accion",value="modificar",formmethod="POST") Modificar
            button.btn.btn-primary(type="submit",name="accion",value="crear",formmethod="POST") Crear
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/@yaireo/tagify/dist/tagify.css")
    script(src="https://cdn.jsdelivr.net/npm/@yaireo/tagify")
    script.
      const especialidades = !{JSON.stringify(especialidades)};
      const input = document.querySelector('input[name="especialidad"]');

      const actuales = input.value
        ? input.value.split(',').map(s => s.trim())
        : [];

      const whitelistFiltrada = especialidades.filter(e =>
        !actuales.includes(e)
      );

      const tagify = new Tagify(input, {
        whitelist: whitelistFiltrada,
        maxTags: 10,
        duplicates: false,
        dropdown: {
          maxItems: 20,
          classname: 'tags-look',
          enabled: 0,
          closeOnSelect: false
        }
      });

      if (actuales.length) {
        tagify.addTags(actuales);
      }

      tagify.on('dropdown:show', function() {
        const actuales = tagify.value.map(tag => tag.value);
        tagify.settings.whitelist = especialidades.filter(e => !actuales.includes(e));
        tagify.dropdown.refilter();
      });

      // Antes de enviar el formulario, convierte los tags a un string JSON de array
      const form = input.closest('form');
      if (form) {
        form.addEventListener('submit', function() {
          const values = tagify.value.map(tag => tag.value);
          input.value = JSON.stringify(values);
        });
      }