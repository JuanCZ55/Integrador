extends ../layout.pug
include ../mixins.pug
block scripts 

block navbar
  include ../mixinsNavbar.pug
  +navbarAdmin()
block main
  .w-75.container
    +alert(mensajeAlert, alertClass)
    div.container-md.border.border-2.border-dark.rounded-3.d-flex.justify-content-center.align-items-center.form-box
      form.p-4(novalidate, action="/admin/cambioRol", method="GET" )
        .mb-3.d-flex.align-items-center.gap-2
          h2.mx-auto.mb-0 Cambio de Rol de Empleados
        small.text-white Permite cambio de rol administrativa (Administrador/Admision) a profesional (Medico/Enfermeria) y viceversa.
        .mb-3
          label.form-label(for="dni") DNI*
          .input-group
            input.form-control(type="number", id="dni", placeholder="48455713", value=(dni) || '', name="dni", required)
            button.btn.btn-outline-secondary.text-light(type="submit", id="btnBuscar") Buscar
        .mb-3   
          label.form-label(for="nombre") Nombre Completo
          input.form-control(type="text", id="nombre", name="nombre", readonly, value=(nombre) || '',placeholder="Anita Gonzalez")
        .mb-3
          label.form-label(for="rolActual") Rol Actual
          input.form-control(type="text", id="rolActual", name="rolActual", readonly, value=(rolActual) || '',placeholder="Administrador")
        .mb-3
          label.form-label(for="nuevoRol") Nuevo Rol*
          select.form-select(id="nuevoRol", name="nuevoRol", required)
            option(value="0") Primero busque por DNI
        button.btn.btn-primary(type="submit",name="accion",value="guardar",formmethod="POST") Guardar
      script.
        const actualRol = document.getElementById("rolActual").value;
        const nuevoRol = document.getElementById("nuevoRol")
        if(actualRol!=""&&actualRol){
          nuevoRol.innerHTML = '';
          nuevoRol.append(new Option("Seleccione el nuevo rol", "0"));
        }
        if (actualRol&& (actualRol==1||actualRol==2)) {
          nuevoRol.append(new Option("Medico", "3"));
          nuevoRol.append(new Option("Enfermero", "4"));
        }else if (actualRol&&(actualRol == 3||actualRol == 4)) {
          nuevoRol.append(new Option("Administrador", "1"));
          nuevoRol.append(new Option("Admisión", "2"));
        }
        actualRol.innerHTML = '';
        const actual= document.getElementById("rolActual");
        switch (actualRol) {
          case "1":
            actual.value = "1-Administrador";
            break;
          case "2":
            actual.value = "2-Admisión";
            break;
          case "3":
            actual.value = "3-Médico";
            break;
          case "4":
            actual.value = "4-Enfermería";
            break;
          default:
            actual.value = "Rol no válido";
        }


