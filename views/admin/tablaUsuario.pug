extends ../layout.pug
include ../mixins.pug

block scripts

block navbar
	include ../mixinsNavbar.pug
	+navbarAdmin()

block main
	.w-75.container
		if mensajeAlert
			+alert(mensajeAlert, alertClass)
		h2.text-center.mt-4 Lista de Usuarios
		.form-group.text-end.mb-3
			form(action="/admin/usuarios" method="get" style="display:inline;")
				button.btn.btn-success(type="submit")
					i.fas.fa-plus.me-1
					| Agregar
		table.table.table-striped.table-bordered.mt-4
			thead
				tr
					th Usuario
					th Rol
					th Estado
			tbody
				if usuarios.length === 0
					tr
						td(colspan="3") No hay usuarios registrados
				else
					each usuario in usuarios
						tr
							td= usuario.username
							td= usuario.rol
							td= usuario.estado