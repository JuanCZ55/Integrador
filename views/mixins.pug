mixin alert(message, alertClass, timeout = 5000)
  if message && message !== ""&&message !== null&&message !== undefined  && (!Array.isArray(message) || message.length > 0)
    - var alertId = 'alert-' + Math.random().toString(36).substr(2, 9)
    .alert(class=`${alertClass}` role="alert" id=alertId)
      if Array.isArray(message)
        each msg, i in message
          | #{msg}
          if i != message.length - 1
            br
      else
        = message
      script.
        setTimeout(() => {
          const alert = document.getElementById('#{alertId}');
          if (alert) {
            alert.style.display = 'none';
          }
        }, #{timeout});
  
mixin select(lName,array, selectedValue,nombre)
  label.form-label(for=lName) #{nombre}*
  select.form-select(name=lName, id=lName)
    if array && array.length
      each item in array
        option(value=item.id, selected=(item.id == selectedValue) ? true : false)= item.nombre
    else
      option(value="") No hay opciones disponibles
      
mixin tabla(thead, tbody)
  table.table.table-striped
    thead
      tr
        each th in thead
          th= th
    tbody
      each row in tbody
        tr
          each cell in row
            td= cell
            
mixin debug(vars)
  pre= JSON.stringify(vars, null, 2)

mixin navbar(op, paciente,id_admision)
    nav
      ul.nav.nav-pills(role="tablist")
        if op === 0
          li.nav-item
            a.nav-link.active(href=`./evaluacion?id_admision=${id_admision}`) Evaluacion
          li.nav-item
            a.nav-link(href=`./medicacion?id_admision=${id_admision}`) Medicacion
          li.nav-item
            a.nav-link(href=`./historial?id_admision=${id_admision}`) Historial
        else if op === 1
          li.nav-item
            a.nav-link(href=`./evaluacion?id_admision=${id_admision}`) Evaluacion
          li.nav-item
            a.nav-link.active(href=`./medicacion?id_admision=${id_admision}`) Medicacion
          li.nav-item
            a.nav-link(href=`./historial?id_admision=${id_admision}`) Historial
        else 
          li.nav-item
            a.nav-link(href=`./evaluacion?id_admision=${id_admision}`) Evaluacion
          li.nav-item
            a.nav-link(href=`./medicacion?id_admision=${id_admision}`) Medicacion
          li.nav-item
            a.nav-link.active(href=`./historial?id_admision=${id_admision}`) Historial
        if paciente && paciente.persona
          li.nav-item.ms-auto
            span.nav.fw-bold Paciente: #{paciente.persona.nombre} #{paciente.persona.apellido} - DNI: #{paciente.persona.dni}